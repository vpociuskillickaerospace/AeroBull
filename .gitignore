# Secrets generated at runtime - never commit these
aerobull_token.txt
AeroEdge/token.json

# PyInstaller build output and cache
build/
dist/
*.spec
__pycache__/
*.pyc

# The compiled executable is a build artifact, not source - distribute via
# GitHub Releases or Datto instead of tracking it in the repo
AeroBull.exe

# AeroEdge's signing key and packed output. The .pem is the private key
# that proves future rebuilds are "the same" extension to Edge - it must
# never be committed anywhere, keep it stored securely outside this repo.
AeroEdge.crx
AeroEdge.pem
